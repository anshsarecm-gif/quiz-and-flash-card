:root {
  --bg: #f6f7f9;
  --surface: #ffffff;
  --text: #1c1f24;
  --muted: #6b7280;
  --border: #d9dde3;
  --accent: #2563eb;
  --good: #16a34a;
  --bad: #dc2626;
}

@media (prefers-color-scheme: dark) {
  :root {
    --bg: #111418;
    --surface: #1b2027;
    --text: #e8eaed;
    --muted: #9aa3af;
    --border: #2f3640;
    --accent: #60a5fa;
    --good: #4ade80;
    --bad: #f87171;
  }
}

* { box-sizing: border-box; }

body {
  margin: 0;
  background: var(--bg);
  color: var(--text);
  font-family: system-ui, -apple-system, "Segoe UI", sans-serif;
}

main {
  max-width: 560px;
  margin: 0 auto;
  padding: 1.5rem 1rem 3rem;
}

h1 { text-align: center; }
h2 { line-height: 1.3; }

section {
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: 14px;
  padding: 1.25rem;
}

label { display: block; margin-bottom: .4rem; font-weight: 600; }
.muted { color: var(--muted); font-size: .95rem; }
.big { font-size: 1.6rem; font-weight: 700; text-align: center; margin: .5rem 0; }

.row { display: flex; gap: .6rem; margin-top: 1rem; }
.row.between { justify-content: space-between; margin-top: 0; }
.row button { flex: 1; }

button, select {
  font: inherit;
  color: var(--text);
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: 10px;
  padding: .75rem 1rem;
  cursor: pointer;
}
select { width: 100%; }
button.primary { background: var(--accent); border-color: var(--accent); color: #fff; }
button:disabled { cursor: default; }
button:focus-visible, select:focus-visible { outline: 3px solid var(--accent); outline-offset: 2px; }

#options { display: grid; gap: .6rem; }
.option { text-align: left; width: 100%; }
.option.correct { border-color: var(--good); background: color-mix(in srgb, var(--good) 18%, var(--surface)); }
.option.wrong { border-color: var(--bad); background: color-mix(in srgb, var(--bad) 18%, var(--surface)); }
.feedback { min-height: 1.5rem; font-weight: 600; }

.timer { height: 8px; background: var(--border); border-radius: 99px; overflow: hidden; margin-top: .6rem; }
#timer-bar { height: 100%; width: 100%; background: var(--accent); transition: width 1s linear; }

#review p { margin: .4rem 0; color: var(--muted); }

.card {
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  gap: .8rem;
  width: 100%;
  min-height: 220px;
  padding: 1.5rem;
  text-align: center;
  font-size: 1.25rem;
}
.card-label { font-size: .8rem; text-transform: uppercase; letter-spacing: .08em; color: var(--accent); }
.card-hint { font-size: .8rem; color: var(--muted); }

@media (prefers-reduced-motion: reduce) {
  #timer-bar { transition: none; }
}
